# Copy this file to .env and fill in your real values.
# Never commit the real .env file to GitHub.

MONGO_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/fashionhub?retryWrites=true&w=majority
MONGO_DB_NAME=fashionhub

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED (32+ chars) when FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string

# "development" locally, "production" when deployed
FLASK_ENV=development

# Only if the frontend is hosted on a DIFFERENT domain than the backend:
# CORS_ORIGINS=https://your-frontend.netlify.app
